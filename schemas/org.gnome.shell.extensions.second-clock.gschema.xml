<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.second-clock" path="/org/gnome/shell/extensions/second-clock/">
    <key name="timezone" type="s">
      <default>"Asia/Colombo"</default>
      <summary>IANA timezone for the second clock, e.g. Asia/Colombo</summary>
    </key>
    <key name="label" type="s">
      <default>"Sri Lanka"</default>
      <summary>Short label shown before the time (leave empty to hide)</summary>
    </key>
    <key name="show-label" type="b">
      <default>true</default>
      <summary>Show the label</summary>
    </key>
    <key name="use-24h" type="b">
      <default>true</default>
      <summary>Use 24-hour format</summary>
    </key>
    <key name="show-date" type="b">
      <default>false</default>
      <summary>Also show the date for that timezone</summary>
    </key>
    <key name="show-weather" type="b">
      <default>true</default>
      <summary>Show current weather next to the clock (Open-Meteo, no API key)</summary>
    </key>
    <key name="weather-label" type="s">
      <default>"Melbourne"</default>
      <summary>Weather location name shown in the menu</summary>
    </key>
    <key name="weather-lat" type="s">
      <default>"-37.814"</default>
      <summary>Weather latitude</summary>
    </key>
    <key name="weather-lon" type="s">
      <default>"144.963"</default>
      <summary>Weather longitude</summary>
    </key>
    <key name="use-fahrenheit" type="b">
      <default>false</default>
      <summary>Show temperatures in Fahrenheit instead of Celsius</summary>
    </key>
    <key name="weather-refresh" type="i">
      <default>30</default>
      <range min="10" max="120"/>
      <summary>Weather refresh interval (minutes)</summary>
    </key>
    <key name="pomodoro-work" type="i">
      <default>25</default>
      <range min="1" max="180"/>
      <summary>Pomodoro work length (minutes)</summary>
    </key>
    <key name="pomodoro-break" type="i">
      <default>5</default>
      <range min="1" max="60"/>
      <summary>Pomodoro break length (minutes)</summary>
    </key>
    <key name="pomodoro-favourite-1" type="i">
      <default>5</default>
      <range min="1" max="240"/>
      <summary>Pomodoro favourite 1 (minutes)</summary>
    </key>
    <key name="pomodoro-favourite-2" type="i">
      <default>10</default>
      <range min="1" max="240"/>
      <summary>Pomodoro favourite 2 (minutes)</summary>
    </key>
    <key name="pomodoro-favourite-3" type="i">
      <default>30</default>
      <range min="1" max="240"/>
      <summary>Pomodoro favourite 3 (minutes)</summary>
    </key>
    <key name="caffeine-on-start" type="b">
      <default>false</default>
      <summary>Turn Caffeine on automatically when the extension starts</summary>
    </key>
    <key name="show-caffeine-icon" type="b">
      <default>true</default>
      <summary>Show a cup symbol in the panel while Caffeine is on</summary>
    </key>
    <key name="caffeine-duration" type="i">
      <default>0</default>
      <range min="0" max="480"/>
      <summary>Turn Caffeine off automatically after this many minutes (0 = never)</summary>
    </key>
  </schema>
</schemalist>
